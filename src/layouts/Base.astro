---
import '../styles/global.css';
import { site } from '../data/site';
import { services } from '../data/services';
import { cities, placeName, regions } from '../data/cities';
import Phone from '../components/Phone.astro';
import bc800 from '@fontsource/barlow-condensed/files/barlow-condensed-latin-800-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  schema?: object[];
  crumbs?: { name: string; href: string }[];
  ogImage?: string;
}
const { title, description, schema = [], crumbs = [], ogImage = '/og.png' } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;

const org = {
  '@context': 'https://schema.org',
  '@type': ['RoofingContractor', 'HomeAndConstructionBusiness'],
  '@id': `${site.url}/#business`,
  name: site.name,
  legalName: site.legalName,
  url: site.url + '/',
  telephone: '+1-314-644-8800',
  image: `${site.url}/og.png`,
  logo: `${site.url}/logo.png`,
  priceRange: '$$',
  foundingDate: String(site.foundedYear),
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.city,
    addressRegion: site.address.region,
    postalCode: site.address.postal,
    addressCountry: site.address.country,
  },
  geo: { '@type': 'GeoCoordinates', latitude: site.geo.lat, longitude: site.geo.lng },
  openingHoursSpecification: [{
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
    opens: '00:00', closes: '23:59',
  }],
  areaServed: cities.map((c) => ({ '@type': 'City', name: placeName(c) })),
  knowsAbout: services.map((s) => s.name),
  founder: { '@type': 'Person', name: site.owner },
  sameAs: Object.values(site.social).filter(Boolean),
  slogan: 'On-site in about two hours, 24/7. Every job gives back to St. Louis first responders.',
};

const breadcrumb = crumbs.length ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [{ name: 'Home', href: '/' }, ...crumbs].map((c, i) => ({
    '@type': 'ListItem', position: i + 1, name: c.name, item: new URL(c.href, site.url).href,
  })),
} : null;

const website = { '@context': 'https://schema.org', '@type': 'WebSite', '@id': `${site.url}/#website`, url: site.url + '/', name: site.name, publisher: { '@id': `${site.url}/#business` }, inLanguage: 'en-US' };
const graph = [org, website, breadcrumb, ...schema].filter(Boolean);
const nav = [
  { href: '/emergency/', label: 'Emergency' },
  { href: '/services/', label: 'Services' },
  { href: '/areas/', label: 'Areas' },
  { href: '/insurance-claims/', label: 'Insurance claims' },
  { href: '/first-responders/', label: 'First responders' },
  { href: '/reviews/', label: 'Reviews' },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="theme-color" content="#142c5c" />
  <link rel="icon" href="/favicon.png" type="image/png" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={site.name} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL(ogImage, site.url).href} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="geo.region" content="US-MO" />
  <meta name="geo.placename" content="St. Louis" />
  <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
  <link rel="alternate" type="application/rss+xml" title="Homeowner guides" href="/rss.xml" />
  <link rel="alternate" type="text/plain" title="LLM summary" href="/llms.txt" />
  <link rel="author" type="text/plain" href="/humans.txt" />
  <link rel="manifest" href="/site.webmanifest" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="preload" href={bc800} as="font" type="font/woff2" crossorigin />
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  <meta property="og:locale" content="en_US" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={new URL(ogImage, site.url).href} />
  {graph.map((g) => <script type="application/ld+json" set:html={JSON.stringify(g)} />)}
  {site.gaId && (
    <>
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${site.gaId}`}></script>
      <script is:inline define:vars={{ id: site.gaId }}>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config',id);</script>
    </>
  )}
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <div class="alertbar">
    <div class="wrap alertbar__in">
      <span class="pulse" aria-hidden="true"></span>
      <span>Crews on call 24/7. On-site in about {site.responseHours} hours across the St. Louis metro.</span>
      <a href={site.phoneHref} data-track="call-alertbar">{site.phone}</a>
    </div>
  </div>
  <header class="hdr">
    <div class="wrap hdr__in">
      <a class="logo" href="/" aria-label={`${site.name} home`}>
        <img class="logo__mark" src="/logo-480.webp" width="480" height="370" alt="" />
        <span class="logo__word"><b>First Responders</b><small>Roofing &amp; Restoration</small></span>
      </a>
      <nav class="nav" aria-label="Main">
        {nav.map((n) => <a href={n.href} aria-current={Astro.url.pathname.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>)}
      </nav>
      <Phone class="hdr__call" track="call-header" />
    </div>
  </header>

  {crumbs.length > 0 && (
    <nav class="crumbs wrap" aria-label="Breadcrumb">
      <a href="/">Home</a>
      {crumbs.map((c, i) => (<><span aria-hidden="true">/</span>{i === crumbs.length - 1 ? <span aria-current="page">{c.name}</span> : <a href={c.href}>{c.name}</a>}</>))}
    </nav>
  )}

  <main id="main"><slot /></main>

  <div class="chevron-band" aria-hidden="true"></div>
  <footer class="ftr">
    <div class="wrap ftr__grid">
      <div>
        <img class="ftr__logo" src="/logo-480.webp" width="480" height="370" alt={site.name} loading="lazy" />
        <p class="ftr__name">{site.name}</p>
        <address>
          {site.address.street}<br />{site.address.city}, {site.address.region} {site.address.postal}<br />
          <a href={site.phoneHref} data-track="call-footer">{site.phone}</a> &middot; Open 24 hours
        </address>
        <p class="ftr__give">{site.giveback}</p>
      </div>
      <div>
        <p class="ftr__h">Restoration</p>
        <ul>{services.filter((s) => s.group === 'restoration').map((s) => <li><a href={`/services/${s.slug}/`}>{s.name}</a></li>)}</ul>
      </div>
      <div>
        <p class="ftr__h">Roofing and exteriors</p>
        <ul>{services.filter((s) => s.group === 'roofing').map((s) => <li><a href={`/services/${s.slug}/`}>{s.name}</a></li>)}</ul>
      </div>
      <div>
        <p class="ftr__h">Service areas</p>
        <ul class="ftr__cities">{cities.map((c) => <li><a href={`/areas/${c.slug}/`}>{placeName(c)}</a></li>)}</ul>
      </div>
    </div>
    <div class="wrap ftr__legal">
      <span>&copy; {new Date().getFullYear()} {site.legalName}</span>
      <a href="/resources/">Homeowner guides</a>
      <a href="/about/">About</a>
      <a href="/contact/">Contact</a>
      <a href="/privacy/">Privacy</a>
      <a href="/sitemap/">Site map</a>
    </div>
  </footer>

  <div class="mbar" role="region" aria-label="Quick contact">
    <a class="mbar__call" href={site.phoneHref} data-track="call-mobilebar">Call 24/7</a>
    <a class="mbar__text" href={`${site.smsHref}?&body=${encodeURIComponent('Hi, I have damage at my property. Address: ')}`} data-track="text-mobilebar">Text photos</a>
  </div>

  <script>
    // Click-to-call and form tracking. Sends to GA4 if configured, and dataLayer for GTM.
    document.addEventListener('click', (e) => {
      const el = (e.target as HTMLElement).closest('[data-track]') as HTMLElement | null;
      if (!el) return;
      const w = window as any;
      (w.dataLayer = w.dataLayer || []).push({ event: 'lead_click', lead_type: el.dataset.track });
      if (typeof w.gtag === 'function') w.gtag('event', 'generate_lead', { method: el.dataset.track });
    });
  </script>
</body>
</html>

<style is:global>
  .skip { position: absolute; left: -9999px; top: 0; z-index: 100; background: var(--hivis); color: var(--navy); padding: 10px 14px; font-weight: 700; }
  .skip:focus { left: 8px; top: 8px; }
  .alertbar { background: var(--navy); color: #cfd9e6; font-size: 0.875rem; }
  .alertbar__in { display: flex; align-items: center; gap: 10px; min-height: 36px; }
  .alertbar__in span:nth-child(2) { flex: 1; }
  .alertbar a { color: var(--hivis); font-weight: 700; text-decoration: none; white-space: nowrap; }
  .pulse { width: 9px; height: 9px; border-radius: 50%; background: #3ddc84; box-shadow: 0 0 0 0 rgba(61,220,132,.6); animation: pulse 2s infinite; flex: none; }
  @keyframes pulse { 70% { box-shadow: 0 0 0 9px rgba(61,220,132,0); } 100% { box-shadow: 0 0 0 0 rgba(61,220,132,0); } }
  @media (prefers-reduced-motion: reduce) { .pulse { animation: none; } }
  @media (max-width: 640px) { .alertbar__in span:nth-child(2) { font-size: 0.8rem; } .alertbar a { display: none; } }

  .hdr { position: sticky; top: 0; z-index: 50; background: rgba(255,255,255,.94); backdrop-filter: saturate(1.4) blur(10px); border-bottom: 1px solid #dde1e6; }
  .hdr__in { display: flex; align-items: center; gap: 24px; min-height: 72px; }
  .logo { display: flex; align-items: center; gap: 10px; text-decoration: none; color: var(--navy); }
  .logo__mark { width: auto; height: 58px; }
  .logo__word { display: flex; flex-direction: column; font-family: var(--display); line-height: 1; }
  .logo__word b { font-weight: 800; font-size: 1.45rem; }
  .logo__word small { font-weight: 600; font-size: 0.95rem; color: var(--steel); }
  .nav { display: flex; gap: 22px; margin-left: auto; }
  .nav a { text-decoration: none; color: var(--ink); font-weight: 600; font-size: 0.95rem; }
  .nav a:hover, .nav a[aria-current] { color: var(--signal); }
  .hdr__call { font-size: 1.2rem !important; }
  @media (max-width: 1080px) { .nav { display: none; } .hdr__call { margin-left: auto; } }
  @media (max-width: 640px) { .hdr__call { padding: .55em .8em; font-size: 1.05rem !important; white-space: nowrap; } .hdr__call .phone__label { display: none; } .logo__word b { font-size: 1.2rem; } .logo__word { display: none; } .logo__mark { height: 52px; } }

  .crumbs { display: flex; flex-wrap: wrap; gap: 8px; font-size: 0.85rem; padding-top: 18px; color: var(--steel); }
  .crumbs a { color: var(--steel); }

  .ftr { background: var(--navy); color: #b9c6d6; padding: 64px 0 120px; font-size: 0.95rem; }
  .ftr a { color: #dfe6ef; text-decoration: none; }
  .ftr a:hover { color: var(--hivis); }
  .ftr__grid { display: grid; gap: 32px; }
  @media (min-width: 860px) { .ftr__grid { grid-template-columns: 1.3fr 1fr 1fr 1.2fr; } }
  .ftr__logo { width: 200px; height: auto; margin-bottom: 16px; }
  .ftr__name { font-family: var(--display); font-size: 1.6rem; font-weight: 800; color: #fff; margin-bottom: .5em; }
  .ftr address { font-style: normal; line-height: 1.7; }
  .ftr__give { margin-top: 1em; color: var(--hivis); }
  .ftr__h { font-weight: 700; color: #fff; margin-bottom: .6em; }
  .ftr ul { list-style: none; padding: 0; margin: 0; line-height: 2; }
  .ftr__cities { columns: 2; }
  .ftr__legal { display: flex; flex-wrap: wrap; gap: 20px; margin-top: 48px; padding-top: 24px; border-top: 1px solid var(--navy-2); font-size: .85rem; }

  .mbar { position: fixed; inset: auto 0 0 0; z-index: 60; display: grid; grid-template-columns: 1.4fr 1fr; gap: 1px; background: var(--navy); padding-bottom: env(safe-area-inset-bottom); }
  .mbar a { display: flex; justify-content: center; align-items: center; min-height: 58px; font-family: var(--display); font-weight: 800; font-size: 1.35rem; text-decoration: none; }
  .mbar__call { background: var(--signal); color: #fff; }
  .mbar__text { background: var(--hivis); color: var(--navy); }
  @media (min-width: 900px) { .mbar { display: none; } .ftr { padding-bottom: 64px; } }
</style>
