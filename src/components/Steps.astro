---
interface Props { steps: { name: string; text: string }[]; heading?: string }
const { steps, heading = 'How it works' } = Astro.props;
---
<section>
  <h2>{heading}</h2>
  <ol class="steps">
    {steps.map((s) => (<li><h3>{s.name}</h3><p>{s.text}</p></li>))}
  </ol>
</section>
<style>
  .steps { list-style: none; counter-reset: s; padding: 0; margin: 0; display: grid; gap: 0; }
  .steps li { counter-increment: s; position: relative; padding: 0 0 28px 72px; }
  .steps li::before { content: counter(s); position: absolute; left: 0; top: -4px; width: 48px; height: 48px; border-radius: 50%; background: var(--navy); color: var(--hivis); font-family: var(--display); font-weight: 800; font-size: 1.6rem; display: grid; place-items: center; }
  .steps li:not(:last-child)::after { content: ''; position: absolute; left: 23px; top: 48px; bottom: 0; width: 2px; background: var(--hivis); }
  .steps h3 { margin-bottom: .25em; }
  .steps p { margin: 0; color: var(--steel); }
</style>
