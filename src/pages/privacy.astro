---
import Page from '../layouts/Page.astro';
import { site } from '../data/site';
---
<Page title="Privacy Policy | First Responders Roofing & Restoration" description="How we use the information you send us." h1="Privacy" crumbs={[{ name: 'Privacy', href: '/privacy/' }]} cta={false}>
  <section class="section"><div class="wrap prose">
    <p>When you call, text or send a form, we use your name, phone number, address and the details you give us only to respond to your request, schedule work and prepare documentation for your insurance claim. We do not sell your information.</p>
    <p>This site uses analytics to understand which pages help people. You can block cookies in your browser.</p>
    <p>Questions: call {site.phone}.</p>
  </div></section>
</Page>
