---
import ServicePage from '../../../layouts/ServicePage.astro';
import { services, cityServiceSlugs } from '../../../data/services';
import { cities } from '../../../data/cities';
export function getStaticPaths() {
  return cities.flatMap((city) => services.filter((s) => cityServiceSlugs.includes(s.slug)).map((service) => ({ params: { city: city.slug, service: service.slug }, props: { city, service } })));
}
const { city, service } = Astro.props;
---
<ServicePage service={service} city={city} />
