---
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import { cities, regions, type Region } from '../../data/cities';
import { site } from '../../data/site';
const order: Region[] = ['stl', 'gulf', 'coast'];
---
<Base title="Service Areas | St. Louis, Metro East, Lake Charles & Carolina Beach | First Responders" description={`24/7 roofing and restoration in ${site.serviceRegion}. Find your city. Call ${site.phone}.`} crumbs={[{ name: 'Areas', href: '/areas/' }]}>
  <section class="section"><div class="wrap">
    <h1>Service areas</h1>
    <p class="lede">Do not see your town? Call {site.phone}. If we can help, we will tell you when a crew can be there.</p>
    {order.map((r) => {
      const inRegion = cities.filter((c) => c.region === r);
      const counties = [...new Set(inRegion.map((c) => `${c.county}, ${c.state}`))];
      return (
        <section class="rg">
          <h2>{regions[r].name}</h2>
          <p class="rg__blurb">{regions[r].blurb}</p>
          {counties.map((co) => (
            <div class="co">
              <h3>{co}</h3>
              <ul>{inRegion.filter((c) => `${c.county}, ${c.state}` === co).map((c) => <li><a href={`/areas/${c.slug}/`}>{c.name}</a></li>)}</ul>
            </div>
          ))}
        </section>
      );
    })}
  </div></section>
  <CtaBand />
</Base>
<style>
  .rg { margin-top: 64px; padding-top: 24px; border-top: 6px solid var(--navy); }
  .rg h2 { font-size: var(--t-4); margin-bottom: .2em; }
  .rg__blurb { color: var(--steel); }
  .co { margin-top: 28px; }
  .co h3 { font-size: 1rem; color: var(--steel); font-family: var(--body); font-weight: 700; }
  .co ul { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 4px 0; }
  .co li { font-family: var(--display); font-weight: 800; font-size: var(--t-3); line-height: 1.15; }
  .co li:not(:last-child)::after { content: '/'; color: var(--hivis); margin: 0 .3em; }
  .co a { color: var(--navy); text-decoration: none; }
  .co a:hover { color: var(--signal); }
</style>
