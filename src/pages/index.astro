---
import Base from '../layouts/Base.astro';
import ContactCard from '../components/ContactCard.astro';
import NightStory from '../components/NightStory.astro';
import StormTrack from '../components/StormTrack.astro';
import ReviewStrip from '../components/ReviewStrip.astro';
import FaqList from '../components/FaqList.astro';
import CtaBand from '../components/CtaBand.astro';
import Phone from '../components/Phone.astro';
import { site, yearsInBusiness } from '../data/site';
import { services } from '../data/services';
import { cities } from '../data/cities';

const faqs = [
  { q: 'Who do I call for water damage in St. Louis at night?', a: `First Responders Roofing & Restoration answers 24/7 at ${site.phone} and has a crew on-site in about ${site.responseHours} hours across St. Louis and St. Charles counties.` },
  { q: 'Do you do both roofing and water damage restoration?', a: 'Yes. Storms often damage the roof and the inside of the house at the same time. We tarp and repair the roof, dry and restore the interior, and handle both under one claim.' },
  { q: 'Do you work with my insurance company?', a: 'Yes. We document the damage with photos, moisture readings and an itemized estimate, and meet your adjuster on-site. You pay your deductible.' },
  { q: 'What areas do you serve?', a: `St. Louis City, St. Louis County and St. Charles County, including ${cities.slice(0, 8).map((c) => c.name).join(', ')} and more, plus the Lake of the Ozarks around Osage Beach.` },
  { q: 'Why are you called First Responders?', a: `Because that is how we work: we show up fast when something goes wrong. And we back the people who do it for a living. ${site.giveback}` },
];
const schema = [{
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
}];
const resto = services.filter((s) => s.group === 'restoration');
const roof = services.filter((s) => s.group === 'roofing');
---
<Base
  title="First Responders Roofing & Restoration | 24/7 St. Louis Water Damage & Roofing"
  description="24/7 water damage restoration, storm damage and roofing in St. Louis and St. Charles. On-site in about 2 hours. We handle your insurance claim. Call (314) 644-8800."
  schema={schema}
>
  <section class="hero">
    <div class="wrap hero__in">
      <div class="hero__copy">
        <h1>
          <span class="hero__big"><span>Water's in.</span><span>Roof's open.</span><span>We're on the way.</span></span>
          <span class="hero__sub">24/7 water damage restoration and storm roofing in St. Louis and St. Charles</span>
        </h1>
        <p class="hero__lede">One call gets a crew to your door in about {site.responseHours} hours, day or night. We stop the damage, dry it out, fix the roof, deal with your insurance company and rebuild.</p>
        <div class="hero__actions">
          <Phone track="call-hero" label="Call 24/7" />
          <a class="btn btn--ghost" href={`${site.smsHref}`} data-track="text-hero">Text us photos</a>
        </div>
        <ul class="hero__facts">
          <li><b>~{site.responseHours} hrs</b> to on-site</li>
          <li><b>24/7</b> live answer</li>
          <li><b>{yearsInBusiness}+ yrs</b> in St. Louis</li>
          <li><b>1 team</b> roof to rebuild</li>
        </ul>
      </div>
      <div class="hero__form"><ContactCard /></div>
    </div>
    <div class="chevron-band" aria-hidden="true"></div>
  </section>

  <NightStory />

  <section class="section svc">
    <div class="wrap">
      <h2>Everything after the damage</h2>
      <p class="lede">Most companies do the roof or the inside. We do both, so a storm that tears off shingles and floods a ceiling is one call, one crew and one claim.</p>
      <div class="svc__cols">
        <div>
          <h3 class="svc__group">Restoration</h3>
          <ul class="svc__list">{resto.map((s) => <li><a href={`/services/${s.slug}/`}><span>{s.name}</span>{s.emergency && <em>24/7</em>}</a></li>)}</ul>
        </div>
        <div>
          <h3 class="svc__group">Roofing and exteriors</h3>
          <ul class="svc__list">{roof.map((s) => <li><a href={`/services/${s.slug}/`}><span>{s.name}</span>{s.emergency && <em>24/7</em>}</a></li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  <StormTrack />

  <section class="fr">
    <div class="wrap fr__in">
      <p class="fr__big">We run toward it.<br />So do they.</p>
      <div>
        <p>Our name is a promise about speed. It is also a thank-you. {site.giveback}{site.responderOffer && ` ${site.responderOffer}`}</p>
        <a class="btn btn--call" href="/first-responders/">About our first responder program</a>
      </div>
    </div>
  </section>

  <section class="section section--concrete">
    <div class="wrap">
      <h2>What customers say</h2>
      <ReviewStrip />
      <p class="rv-more"><a href="/reviews/">Read more reviews</a></p>
    </div>
  </section>

  <section class="section areas">
    <div class="wrap">
      <h2>Where we respond</h2>
      <p class="lede">Dispatched from {site.address.street} in St. Louis County, minutes from I-270 and Page Avenue.</p>
      <ul class="areas__list">{cities.map((c) => <li><a href={`/areas/${c.slug}/`}>{c.name}</a></li>)}</ul>
    </div>
  </section>

  <section class="section section--concrete">
    <div class="wrap" style="max-width: 860px"><FaqList faqs={faqs} /></div>
  </section>

  <CtaBand />
</Base>

<style>
  .hero { background: var(--paper); position: relative; overflow: hidden; }
  .hero::before { content: ''; position: absolute; right: -10vw; top: -20vh; width: 60vw; height: 140%; background: var(--concrete); transform: skewX(-12deg); }
  .hero__in { position: relative; display: grid; gap: 40px; padding-block: clamp(36px, 6vw, 80px) clamp(48px, 7vw, 96px); align-items: center; }
  @media (min-width: 1000px) { .hero__in { grid-template-columns: 1.35fr 1fr; gap: 64px; } }
  .hero h1 { margin: 0 0 24px; }
  .hero__big { display: flex; flex-direction: column; font-size: clamp(3.2rem, 7.4vw, 6.6rem); line-height: .86; letter-spacing: -.02em; }
  .hero__big span { display: block; animation: rise .8s cubic-bezier(.2,.8,.2,1) both; }
  .hero__big span:nth-child(2) { animation-delay: .12s; }
  .hero__big span:nth-child(3) { animation-delay: .24s; color: var(--signal); }
  @keyframes rise { from { transform: translateY(40%); opacity: 0; clip-path: inset(0 0 100% 0); } to { transform: none; opacity: 1; clip-path: inset(0 0 -10% 0); } }
  @media (prefers-reduced-motion: reduce) { .hero__big span { animation: none; } }
  .hero__sub { display: block; font-family: var(--body); font-weight: 700; font-size: var(--t-1); color: var(--navy); margin-top: 22px; line-height: 1.3; max-width: 34ch; letter-spacing: 0; }
  .hero__lede { font-size: var(--t-1); color: var(--steel); max-width: 52ch; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 32px; color: var(--navy); }
  .hero__facts { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px 28px; list-style: none; padding: 0; margin: 0; max-width: 520px; }
  @media (min-width: 640px) { .hero__facts { grid-template-columns: repeat(4, auto); } }
  .hero__facts li { font-size: .9rem; color: var(--steel); line-height: 1.2; border-left: 3px solid var(--hivis); padding-left: 10px; }
  .hero__facts b { display: block; font-family: var(--display); font-size: 1.7rem; color: var(--navy); }

  .svc__cols { display: grid; gap: 40px; margin-top: 40px; }
  @media (min-width: 860px) { .svc__cols { grid-template-columns: 1fr 1fr; gap: 64px; } }
  .svc__group { font-family: var(--body); font-weight: 700; font-size: 1rem; color: var(--steel); }
  .svc__list { list-style: none; padding: 0; margin: 0; }
  .svc__list a { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 16px 0; border-bottom: 2px solid var(--concrete); text-decoration: none; font-family: var(--display); font-weight: 800; font-size: var(--t-3); line-height: 1; color: var(--navy); background: linear-gradient(var(--hivis), var(--hivis)) left bottom / 0 4px no-repeat; transition: background-size .35s, color .2s, padding .3s; }
  .svc__list a:hover { background-size: 100% 4px; color: var(--signal); padding-left: 10px; }
  .svc__list em { font-style: normal; font-family: var(--body); font-size: .8rem; font-weight: 700; background: var(--signal); color: #fff; padding: 3px 8px; border-radius: 3px; }

  .fr { background: var(--hivis); color: var(--navy); }
  .fr__in { display: grid; gap: 32px; padding-block: clamp(56px, 9vw, 120px); align-items: end; }
  @media (min-width: 900px) { .fr__in { grid-template-columns: 1.4fr 1fr; } }
  .fr__big { font-family: var(--display); font-weight: 800; font-size: var(--t-6); line-height: .86; margin: 0; max-width: none; letter-spacing: -.02em; }
  .fr p:not(.fr__big) { font-size: var(--t-1); }

  .rv-more { margin-top: 24px; font-weight: 700; }
  .areas__list { list-style: none; padding: 0; margin: 32px 0 0; display: flex; flex-wrap: wrap; gap: 6px 0; }
  .areas__list li { font-family: var(--display); font-weight: 800; font-size: var(--t-3); line-height: 1.15; }
  .areas__list li:not(:last-child)::after { content: '/'; color: var(--hivis); margin: 0 .35em; }
  .areas__list a { color: var(--navy); text-decoration: none; }
  .areas__list a:hover { color: var(--signal); }
</style>
